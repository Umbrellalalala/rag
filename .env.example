# ===== 聊天模型 API 配置（选择云端 API 时填写）=====
# 任选一种云端服务，填入对应的 API Key 与 base_url（base_url 可不填使用默认值）

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问（阿里云 DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Moonshot Kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ===== 其他 =====
# 使用本地 Ollama 时无需填写以上内容，仅需启动 Ollama 服务（默认 http://localhost:11434）
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace 镜像（国内加速下载 embedding 模型）
HF_ENDPOINT=https://hf-mirror.com
